<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Rasoi Tale — recipes with a little soul</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#fff8ed">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", defer: true, "data-turbo-track": "reload" %>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="<%= root_path %>" aria-label="Rasoi Tale home">
        <span class="brand-mark" aria-hidden="true">🍲</span>
        <span>Rasoi<span class="brand-accent"> Tale</span></span>
      </a>
      <span class="header-note">recipes with a little soul <span aria-hidden="true">✦</span></span>
    </header>
    <main>
      <%= yield %>
    </main>
    <footer class="site-footer">Every recipe has a story. Let’s make yours. <span aria-hidden="true">♡</span></footer>
  </body>
</html>
