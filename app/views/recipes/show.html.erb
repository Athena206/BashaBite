<section class="detail-page">
  <%= link_to "← All recipes", root_path, class: "back-link" %>
  <p class="eyebrow"><%= @recipe.cuisine.upcase %> RECIPE</p>
  <h1><%= @recipe.title %></h1>
  <div class="audio-player">
    <button class="listen-button" type="button" data-audio-play disabled>Preparing voice…</button>
    <audio controls preload="none" data-gnani-audio data-audio-url="<%= audio_recipe_path(@recipe) %>">Your browser does not support audio playback.</audio>
    <p class="audio-status" data-audio-status aria-live="polite">Getting the spoken instructions ready…</p>
  </div>
  <div class="recipe-columns">
    <div class="recipe-panel">
      <h3>Ingredients</h3>
      <ul class="ingredient-list">
        <% @recipe.ingredients.lines.map(&:strip).reject(&:blank?).each do |ingredient| %>
          <li><span class="ingredient-dot"></span><%= ingredient %></li>
        <% end %>
      </ul>
    </div>
    <div class="recipe-panel">
      <h3>Let’s make it</h3>
      <ol class="instruction-list">
        <% @recipe.instruction_steps.each do |step| %>
          <li><span><%= step %></span></li>
        <% end %>
      </ol>
    </div>
  </div>
</section>
